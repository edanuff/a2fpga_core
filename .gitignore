# Ignore personal Claude config (settings.local.json, worktrees) but SHARE
# skills, project hooks, and shared settings (e.g. the BL616 flash-guard hook).
/.claude/*
!/.claude/skills/
!/.claude/settings.json
!/.claude/hooks/
/boards/a2mega/src/a2fpga_esp32/build
/boards/a2n20v2-Enhanced/src/a2n20_bl616/firmware/build/*
!/boards/a2n20v2-Enhanced/src/a2n20_bl616/firmware/build/build_out/
/boards/a2n20v2-Enhanced/src/a2n20_bl616/firmware/build/build_out/*
!/boards/a2n20v2-Enhanced/src/a2n20_bl616/firmware/build/build_out/a2n20_bl616_bl616.bin
/boards/a2n20v2-Enhanced/src/a2n20_bl616/firmware_host/build/*
!/boards/a2n20v2-Enhanced/src/a2n20_bl616/firmware_host/build/build_out/
/boards/a2n20v2-Enhanced/src/a2n20_bl616/firmware_host/build/build_out/*
!/boards/a2n20v2-Enhanced/src/a2n20_bl616/firmware_host/build/build_out/a2n20_bl616_host_bl616.bin
!/boards/a2n20v2-Enhanced/src/a2n20_bl616/recovery/*.bin
*.m4a
*.wav
*.mov

# Gowin PnR route databases — regenerable intermediates, ~100-140 MB on
# GW5A parts (exceeds GitHub's file limit). The .fs bitstream and reports
# are the tracked build products.
boards/*/impl/pnr/*.pr
boards/a2mega/captures/

# S7 fast-core Fmax probes (boards/a2mega/docs/gs_socket_s7_fast_core_exploration.md):
# timing instruments, never flashed — keep their bitstreams and resource snapshots local
**/impl/pnr/a2mega_cpu_probe_*
**/impl/a2mega_cpu_probe_*_resources.json
