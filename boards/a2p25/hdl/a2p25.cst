// a2p25 displayport1 board revision — pin constraints
// Ball map: docs/PINOUT_DISPLAYPORT1.md section 2. Apple bus unchanged from
// rev 0 except D7 (B3). HyperRAM, DP AUX/HPD, ESP32 OPI and the LED are new;
// the HDMI, QSPI/LCAM, I2S and UART balls of rev 0 are reused by them.
// The D-PHY M0 quad and JTAG/RECONFIG/DONE are dedicated pads (no entries).

IO_LOC  "clk" E2;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "a2_bus_oe" H5;
IO_PORT "a2_bus_oe" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "a2_a_dir" J5;
IO_PORT "a2_a_dir" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "a2_d_dir" E11;
IO_PORT "a2_d_dir" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "a2_rw_n" E10;
IO_PORT "a2_rw_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "a2_inh_n" A11;
IO_PORT "a2_inh_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "a2_reset_n" A10;
IO_PORT "a2_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "a2_rdy_n" D11;
IO_PORT "a2_rdy_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "a2_irq_n" D10;
IO_PORT "a2_irq_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "a2_dma_n" C11;
IO_PORT "a2_dma_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "a2_nmi_n" C10;
IO_PORT "a2_nmi_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "a2_mb20" G10;
IO_PORT "a2_mb20" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_sync_n" B11;
IO_PORT "a2_sync_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_m2sel_n" J10;
IO_PORT "a2_m2sel_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "a2_phi1" H11;
IO_PORT "a2_phi1" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_q3" H10;
IO_PORT "a2_q3" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_7M" G11;
IO_PORT "a2_7M" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_d[0]" L9;
IO_PORT "a2_d[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_d[1]" K9;
IO_PORT "a2_d[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_d[2]" J8;
IO_PORT "a2_d[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_d[3]" K8;
IO_PORT "a2_d[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_d[4]" F7;
IO_PORT "a2_d[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_d[5]" F6;
IO_PORT "a2_d[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_d[6]" E8;
IO_PORT "a2_d[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_d[7]" B3;   // D7 moved from E3 (now HyperRAM RWDS) to B3
IO_PORT "a2_d[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[0]" L5;
IO_PORT "a2_a[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[1]" K5;
IO_PORT "a2_a[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[2]" H8;
IO_PORT "a2_a[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[3]" H7;
IO_PORT "a2_a[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[4]" G7;
IO_PORT "a2_a[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[5]" G8;
IO_PORT "a2_a[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[6]" F5;
IO_PORT "a2_a[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[7]" G5;
IO_PORT "a2_a[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[8]" K7;
IO_PORT "a2_a[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[9]" J7;
IO_PORT "a2_a[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[10]" L7;
IO_PORT "a2_a[10]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[11]" L8;
IO_PORT "a2_a[11]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[12]" L10;
IO_PORT "a2_a[12]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[13]" K10;
IO_PORT "a2_a[13]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[14]" K11;
IO_PORT "a2_a[14]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a2_a[15]" L11;
IO_PORT "a2_a[15]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// DisplayPort AUX (TLVDS pair, bank 2 at 3.3 V) and PD-derived HPD from the ESP32
IO_LOC  "dp_aux_p" L2,L1;
IO_PORT "dp_aux_p" IO_TYPE=LVDS25 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "dp_hpd" B2;
IO_PORT "dp_hpd" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// HyperRAM U6
IO_LOC  "hr_ck" J11;
IO_PORT "hr_ck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "hr_cs_n" C3;
IO_PORT "hr_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "hr_rwds" E3;
IO_PORT "hr_rwds" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "hr_dq[0]" L4;
IO_LOC  "hr_dq[1]" L3;
IO_LOC  "hr_dq[2]" J1;
IO_LOC  "hr_dq[3]" J2;
IO_LOC  "hr_dq[4]" G4;
IO_LOC  "hr_dq[5]" H4;
IO_LOC  "hr_dq[6]" H1;
IO_LOC  "hr_dq[7]" H2;
IO_PORT "hr_dq[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hr_dq[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hr_dq[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hr_dq[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hr_dq[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hr_dq[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hr_dq[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hr_dq[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ESP32-S3 OPI link (ESP32 master): CLK D1, D0-D7 = C2 F2 F1 A1 K1 K2 J4 K4
IO_LOC  "esp_sclk" D1;
IO_PORT "esp_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "esp_data[0]" C2;
IO_PORT "esp_data[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "esp_data[1]" F2;
IO_PORT "esp_data[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "esp_data[2]" F1;
IO_PORT "esp_data[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "esp_data[3]" A1;
IO_PORT "esp_data[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "esp_data[4]" K1;
IO_PORT "esp_data[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "esp_data[5]" K2;
IO_PORT "esp_data[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "esp_data[6]" J4;
IO_PORT "esp_data[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "esp_data[7]" K4;
IO_PORT "esp_data[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// FPGA LED (active high)
IO_LOC  "led" B10;
IO_PORT "led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
