// flash_rescue — MSPI pads as user IO (process config "MSPI": true).
// Ball numbers hand-verified against the Tang Mega 60K SOM schematic
// (MSPI FLASH sheet, W25Q64 U1200), 2026-08-15.
IO_LOC  "clk50_in" V22;
IO_PORT "clk50_in" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "uart_tx" H13;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "led[0]" D15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "led[1]" D14;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "led[2]" R14;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "flash_cs" T19;
IO_PORT "flash_cs" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "flash_clk" L12;
IO_PORT "flash_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "flash_mosi" P22;
IO_PORT "flash_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "flash_miso" R22;
IO_PORT "flash_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "flash_wp" P21;
IO_PORT "flash_wp" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "flash_hold" R21;
IO_PORT "flash_hold" IO_TYPE=LVCMOS33 PULL_MODE=UP;
