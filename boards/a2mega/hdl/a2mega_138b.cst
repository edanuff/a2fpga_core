// Physical constraints — Tang Mega 138K SOM variant (GW5AST-138B).
// REGENERATED 08-30 from a2mega.cst (1.0a3 pinout + campaign-proven
// TLVDS AUX) with the documented per-die deltas: GW5AST has no
// SSTL15_I/SSTL15D_I IO types (SSTL15/SSTL15D, DRIVE=8 per the proven
// 138K reference), and AB13 (button) sits in a 3.3 V bank on this die.
// Keep in sync with a2mega.cst (this file = that file + these deltas).

// cm_life spine note (08-31, PnR campaign): the GTR12's cm_life clock
// tree was split by the upar_arbiter's pass-through port — fixed by a
// hand-edit in dp_serdes.v (export the source net directly) so the
// whole tree auto-promotes as one net. CLOCK_LOC could NOT reach the
// vendor-internal net segment: BUFS = CT1154 (unsupported on GW5AST),
// and every name form = CT1135 (object not found). Don't retry that.

//CLOCK_LOC "clk_hdmi_w" BUFG[0] = CLK;
//CLOCK_LOC "clk_pixel_w" BUFG[1] = CLK;
//CLOCK_LOC "rstn_r" BUFG[0] = SR;
//CLOCK_LOC "reset_x5_w" BUFG[1] = SR;

// Clock & Reset/Button S1

IO_LOC  "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "rst" F4;
IO_PORT "rst" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5; 

IO_LOC "button" AB13;
// AB13 moved banks between dies: Bank 9 (1.5 V) on GW5AT-60B, Bank 5 on
// GW5AST-138B (3.3 V with the UART pins; `button` is unused, safe either way).
IO_PORT "button" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// UART (1.0a3: moved to the old USB-A balls — J2.66/68)
// uart_rx = data FROM the ESP32 (net ESP32_TX), uart_tx = data TO it.

IO_LOC "uart_tx" H13;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "uart_rx" G13;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;


// DisplayPort (replaces HDMI on 1.0a3). Main-link lanes + 135 MHz refclk
// are dedicated SERDES bumps configured in the PHY IP — no entries here.
// AUX = pseudo-diff pair on the old HDMI clock balls (a true diff pair),
// through the TUSB1046A onto SBU1/2; bias + AC coupling on the carrier.
// HPD level/IRQ comes from the ESP32 (ESP32_GPIO0); pull-down so HPD
// idles deasserted while the ESP32 is unprogrammed or booting.

// CLOSED-LOOP AUX (08-30 port from dp_test, campaign-proven): true
// LVDS pair with both-leg pulldowns (decays the AC-coupled stored
// offset; see dp_aux_pad.sv rounds 6-10). Old pseudo-diff entries:
//   IO_PORT "dp_aux_p"/"dp_aux_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "dp_aux_p" G15,G16;
IO_PORT "dp_aux_p" IO_TYPE=LVDS25 PULL_MODE=DOWN;

IO_LOC  "dp_hpd" A19;
IO_PORT "dp_hpd" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// DIP Switches

IO_LOC  "dip_switches_n[0]" J16;
IO_PORT "dip_switches_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "dip_switches_n[1]" F13;
IO_PORT "dip_switches_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "dip_switches_n[2]" F14;
IO_PORT "dip_switches_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "dip_switches_n[3]" F15;
IO_PORT "dip_switches_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// LEDs D1-D4 (1.0a3: active low, anode +3V3 via R23-R26)

IO_LOC  "led[0]" D15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "led[1]" D14;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "led[2]" R14;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "led[3]" P14;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// (USB-A host port removed on 1.0a3 — its balls G13/H13 now carry the
// UART, see above. The historical D+/D- swap saga lives in git history.)

