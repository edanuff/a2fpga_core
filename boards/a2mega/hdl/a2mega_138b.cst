IO_LOC  "gs_d[6]" U20;
IO_LOC  "gs_d[7]" V20;
IO_PORT "gs_d[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_d[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_d[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_d[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_d[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_d[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
