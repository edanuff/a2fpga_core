IO_LOC  "esp_data[7]" B17;
IO_PORT "esp_data[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "esp_sclk" A18;
IO_PORT "esp_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

