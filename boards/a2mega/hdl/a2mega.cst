// ESP32-S3 OSPI Lines

// 1.0a3 relocated the whole OSPI bus (old balls E13/E14/... now carry
// ESP32_INT_N and the PPO bus). Map: docs/a2mega_pinmap_1_0a3.csv.

IO_LOC  "esp_data[0]" A14;
IO_PORT "esp_data[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "esp_data[1]" B15;
IO_PORT "esp_data[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "esp_data[2]" B16;
IO_PORT "esp_data[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

