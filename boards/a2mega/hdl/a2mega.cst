// Bus Address Lines

IO_LOC  "a2_a[0]" T20;
IO_PORT "a2_a[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "a2_a[1]" R19;
IO_PORT "a2_a[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "a2_a[2]" P19;
IO_PORT "a2_a[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// SSPI
IO_LOC  "a2_a[3]" N22;
//IO_LOC  "a2_a[3]" L14;
IO_PORT "a2_a[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

