// GS socket pins — GW5AST-138B (Tang Mega 138K SOM) balls, from
// docs/a2mega_pinmap_1_0a3.csv.  Merged into a2mega_138b.cst at S4; the
// 60K SOM uses the same balls (a2mega.cst) — only the bank numbers differ.
// Port names are the gs_* ports of the top level (gs_d is the inout).
//
// Control inputs (U13 port 1, 5 V -> 3.3 V).  Pulled to their inactive
// state so an unarmed card (shifter disabled, pads floating) reads idle;
// PH2 pulled down so a floating clock does not toggle.
IO_LOC  "gs_ph2" AB17;
IO_PORT "gs_ph2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "gs_rdy" AB16;
IO_PORT "gs_rdy" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "gs_irq_n" Y17;
IO_PORT "gs_irq_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "gs_nmi_n" N13;
IO_PORT "gs_nmi_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "gs_res_n" AA15;
IO_PORT "gs_res_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "gs_abort_n" AA16;
IO_PORT "gs_abort_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "gs_be" N14;
IO_PORT "gs_be" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Data (U13 port 2, bidirectional)
IO_LOC  "gs_d[0]" N15;
IO_LOC  "gs_d[1]" M15;
IO_LOC  "gs_d[2]" M16;
IO_LOC  "gs_d[3]" N17;
IO_LOC  "gs_d[4]" P17;
IO_LOC  "gs_d[5]" M17;
IO_LOC  "gs_d[6]" U20;
IO_LOC  "gs_d[7]" V20;
IO_PORT "gs_d[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_d[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_d[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_d[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_d[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_d[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_d[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_d[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Address (U14, output only)
IO_LOC  "gs_a[0]" V17;
IO_LOC  "gs_a[1]" W17;
IO_LOC  "gs_a[2]" Y18;
IO_LOC  "gs_a[3]" Y19;
IO_LOC  "gs_a[4]" AA18;
IO_LOC  "gs_a[5]" AB18;
IO_LOC  "gs_a[6]" W19;
IO_LOC  "gs_a[7]" W20;
IO_LOC  "gs_a[8]" AB20;
IO_LOC  "gs_a[9]" AA21;
IO_LOC  "gs_a[10]" AB22;
IO_LOC  "gs_a[11]" Y22;
IO_LOC  "gs_a[12]" Y21;
IO_LOC  "gs_a[13]" AB21;
IO_LOC  "gs_a[14]" AA20;
IO_LOC  "gs_a[15]" AA19;
IO_PORT "gs_a[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[10]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[11]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[12]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[13]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[14]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "gs_a[15]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Control outputs.  The three shifter enables and RDY_OUT are also pulled
// up on the board (4.7 k) so they idle inactive while the FPGA configures.
IO_LOC  "gs_rw" U18;
IO_PORT "gs_rw" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "gs_vp" W14;
IO_PORT "gs_vp" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "gs_rdy_out" V15;
IO_PORT "gs_rdy_out" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gs_d_dir" W21;
IO_PORT "gs_d_dir" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "gs_data_oe_n" AB15;
IO_PORT "gs_data_oe_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gs_addr_oe_n" Y16;
IO_PORT "gs_addr_oe_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gs_oe_n" W15;
IO_PORT "gs_oe_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
