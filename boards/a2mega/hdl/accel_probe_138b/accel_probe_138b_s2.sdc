// S7 accelerator timing probe (accel_probe_top): the accelerator domain at the
// 100 MHz pin-sequencer clock, the core stepping every STEP_CLKS = 2 clks
// (50 MHz).  GENERATED by gen_sdc.py - edit that.  The exceptions below are the
// timing contract gs_accel_broker documents and tb_gs_broker.sv asserts in clks
// (step spacing, read launch -> use, select steady, no decision before the
// second clk of a step, settle time of the registered decode); everything not
// listed is an ordinary one-clk path.
// See boards/a2mega/docs/gs_socket_s7_fast_core_exploration.md.
create_clock -name clk100 -period 10.000 -waveform {0 5.000} [get_ports {clk50_in}]
set_clock_uncertainty 0.5 -setup -from [get_clocks {clk100}]

// gs_ph2 and the sequencer clock are asynchronous (hdl/twgs/gs_socket.sdc).  The
// socket data byte (u_brk/d_f, PHI2-fall flops) is taken by the core the clk after
// the synchronised fall event: at least three clks after the fall.
create_clock -name gs_ph2 -period 349.0 -waveform {209.4 349.0} [get_ports {gs_ph2}]
set_clock_groups -asynchronous -group [get_clocks {gs_ph2}] -group [get_clocks {clk100}]

// ---- STEP_CLKS-cycle paths (two clks): launched at a core step, captured at the next.
// Startpoints: the core's registers; the memories' read ports and the block-select
// registers of their output muxes; the data-source select.
// Endpoints: the core's registers; the next read address (block pins and block
// selects); what the broker registers at the launch (addresses held, select, the
// next step's status and decode).
set_multicycle_path 2 -setup -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {*ram_sel_* *rom_sel_*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {*ram_sel_* *rom_sel_*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {u_brk/ld_phys* u_brk/ld_ram* u_brk/ld_rom* u_brk/use_lm_r* u_brk/rom_r* u_brk/pl_r_* u_brk/pl_w_* u_brk/pl_side* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/pl_fresh* u_brk/ea_r* lm_raddr_q*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {u_brk/ld_phys* u_brk/ld_ram* u_brk/ld_rom* u_brk/use_lm_r* u_brk/rom_r* u_brk/pl_r_* u_brk/pl_w_* u_brk/pl_side* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/pl_fresh* u_brk/ea_r* lm_raddr_q*}]
set_multicycle_path 2 -setup -end -from [get_pins {*mram_*_s/CLKB *mrom_*_s/CLKB}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 1 -hold  -end -from [get_pins {*mram_*_s/CLKB *mrom_*_s/CLKB}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 2 -setup -end -from [get_pins {*mram_*_s/CLKB *mrom_*_s/CLKB}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 1 -hold  -end -from [get_pins {*mram_*_s/CLKB *mrom_*_s/CLKB}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 2 -setup -end -from [get_pins {*mram_*_s/CLKB *mrom_*_s/CLKB}] -to [get_regs {*ram_sel_* *rom_sel_*}]
set_multicycle_path 1 -hold  -end -from [get_pins {*mram_*_s/CLKB *mrom_*_s/CLKB}] -to [get_regs {*ram_sel_* *rom_sel_*}]
set_multicycle_path 2 -setup -end -from [get_pins {*mram_*_s/CLKB *mrom_*_s/CLKB}] -to [get_regs {u_brk/ld_phys* u_brk/ld_ram* u_brk/ld_rom* u_brk/use_lm_r* u_brk/rom_r* u_brk/pl_r_* u_brk/pl_w_* u_brk/pl_side* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/pl_fresh* u_brk/ea_r* lm_raddr_q*}]
set_multicycle_path 1 -hold  -end -from [get_pins {*mram_*_s/CLKB *mrom_*_s/CLKB}] -to [get_regs {u_brk/ld_phys* u_brk/ld_ram* u_brk/ld_rom* u_brk/use_lm_r* u_brk/rom_r* u_brk/pl_r_* u_brk/pl_w_* u_brk/pl_side* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/pl_fresh* u_brk/ea_r* lm_raddr_q*}]
set_multicycle_path 2 -setup -end -from [get_regs {*ram_sel_* *rom_sel_*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 1 -hold  -end -from [get_regs {*ram_sel_* *rom_sel_*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 2 -setup -end -from [get_regs {*ram_sel_* *rom_sel_*}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 1 -hold  -end -from [get_regs {*ram_sel_* *rom_sel_*}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 2 -setup -end -from [get_regs {*ram_sel_* *rom_sel_*}] -to [get_regs {*ram_sel_* *rom_sel_*}]
set_multicycle_path 1 -hold  -end -from [get_regs {*ram_sel_* *rom_sel_*}] -to [get_regs {*ram_sel_* *rom_sel_*}]
set_multicycle_path 2 -setup -end -from [get_regs {*ram_sel_* *rom_sel_*}] -to [get_regs {u_brk/ld_phys* u_brk/ld_ram* u_brk/ld_rom* u_brk/use_lm_r* u_brk/rom_r* u_brk/pl_r_* u_brk/pl_w_* u_brk/pl_side* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/pl_fresh* u_brk/ea_r* lm_raddr_q*}]
set_multicycle_path 1 -hold  -end -from [get_regs {*ram_sel_* *rom_sel_*}] -to [get_regs {u_brk/ld_phys* u_brk/ld_ram* u_brk/ld_rom* u_brk/use_lm_r* u_brk/rom_r* u_brk/pl_r_* u_brk/pl_w_* u_brk/pl_side* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/pl_fresh* u_brk/ea_r* lm_raddr_q*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/use_lm_r* u_brk/rom_r*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/use_lm_r* u_brk/rom_r*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/use_lm_r* u_brk/rom_r*}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/use_lm_r* u_brk/rom_r*}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/use_lm_r* u_brk/rom_r*}] -to [get_regs {*ram_sel_* *rom_sel_*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/use_lm_r* u_brk/rom_r*}] -to [get_regs {*ram_sel_* *rom_sel_*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/use_lm_r* u_brk/rom_r*}] -to [get_regs {u_brk/ld_phys* u_brk/ld_ram* u_brk/ld_rom* u_brk/use_lm_r* u_brk/rom_r* u_brk/pl_r_* u_brk/pl_w_* u_brk/pl_side* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/pl_fresh* u_brk/ea_r* lm_raddr_q*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/use_lm_r* u_brk/rom_r*}] -to [get_regs {u_brk/ld_phys* u_brk/ld_ram* u_brk/ld_rom* u_brk/use_lm_r* u_brk/rom_r* u_brk/pl_r_* u_brk/pl_w_* u_brk/pl_side* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/pl_fresh* u_brk/ea_r* lm_raddr_q*}]

// ---- ADDR_CLKS = 1: a step is decided in its first clk, so everything the
// decision is made from and everything it registers is an ordinary one-clk path.
// The one exception is the registered copy of the direct decode, which a step that
// was not decoded ahead gives SLOW_CLKS - 1 = two clks to settle.
set_multicycle_path 2 -setup -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {u_brk/aq_*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {u_brk/aq_*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/ea_r*}] -to [get_regs {u_brk/aq_*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/ea_r*}] -to [get_regs {u_brk/aq_*}]

// ---- a read that was not launched ahead: its registered address is presented to
// the memories for two clks and launched in the second
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/ml_sel_r* u_brk/ml_sel_c* u_brk/ml_phys* u_brk/ml_rom*}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/ml_sel_r* u_brk/ml_sel_c* u_brk/ml_phys* u_brk/ml_rom*}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/ml_sel_r* u_brk/ml_sel_c* u_brk/ml_phys* u_brk/ml_rom*}] -to [get_regs {*ram_sel_* *rom_sel_*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/ml_sel_r* u_brk/ml_sel_c* u_brk/ml_phys* u_brk/ml_rom*}] -to [get_regs {*ram_sel_* *rom_sel_*}]

// ---- the broker's view of the core's reset changes at a PHI2-fall event; the PHY
// takes a cycle at its issue point, never sooner than two clks after one
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/run_c*}] -to [get_regs {u_phy/*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/run_c*}] -to [get_regs {u_phy/*}]

// ---- the registered copy of the direct decode (steady from the end of the second
// clk) gives a write that was not decoded ahead its RAM address; such a write is
// in the fourth clk
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/aq_*}] -to [get_pins {*mram_*_s/DI* *mram_*_s/CEA *mram_*_s/ADA*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/aq_*}] -to [get_pins {*mram_*_s/DI* *mram_*_s/CEA *mram_*_s/ADA*}]

// ---- verify (native, card memory of record): memory data against the socket byte, at
// the end of the socket cycle
set_multicycle_path 2 -setup -end -from [get_pins {*mram_*_s/CLKB *mrom_*_s/CLKB}] -to [get_regs {u_brk/verify_*}]
set_multicycle_path 1 -hold  -end -from [get_pins {*mram_*_s/CLKB *mrom_*_s/CLKB}] -to [get_regs {u_brk/verify_*}]
set_multicycle_path 2 -setup -end -from [get_regs {*ram_sel_* *rom_sel_*}] -to [get_regs {u_brk/verify_*}]
set_multicycle_path 1 -hold  -end -from [get_regs {*ram_sel_* *rom_sel_*}] -to [get_regs {u_brk/verify_*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/use_lm_r* u_brk/rom_r*}] -to [get_regs {u_brk/verify_*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/use_lm_r* u_brk/rom_r*}] -to [get_regs {u_brk/verify_*}]

// ---- the mode changes only when the core steps; it selects the interrupt lines the
// core sees and so reaches the next step's status
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/mode_native* u_brk/mode_bypass*}] -to [get_regs {u_brk/ld_phys* u_brk/ld_ram* u_brk/ld_rom* u_brk/use_lm_r* u_brk/rom_r* u_brk/pl_r_* u_brk/pl_w_* u_brk/pl_side* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/pl_fresh* u_brk/ea_r* lm_raddr_q*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/mode_native* u_brk/mode_bypass*}] -to [get_regs {u_brk/ld_phys* u_brk/ld_ram* u_brk/ld_rom* u_brk/use_lm_r* u_brk/rom_r* u_brk/pl_r_* u_brk/pl_w_* u_brk/pl_side* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/pl_fresh* u_brk/ea_r* lm_raddr_q*}]

// ---- the memory-map switches change at the end of a socket cycle; the step that
// follows is never decoded or launched ahead, so they reach a launch (address,
// decode) three clks later at the soonest and the registered copy of the direct
// decode two
set_multicycle_path 3 -setup -end -from [get_regs {u_brk/u_replica/*}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 2 -hold  -end -from [get_regs {u_brk/u_replica/*}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 3 -setup -end -from [get_regs {u_brk/u_replica/*}] -to [get_regs {*ram_sel_* *rom_sel_*}]
set_multicycle_path 2 -hold  -end -from [get_regs {u_brk/u_replica/*}] -to [get_regs {*ram_sel_* *rom_sel_*}]
set_multicycle_path 3 -setup -end -from [get_regs {u_brk/u_replica/*}] -to [get_regs {u_brk/ld_phys* u_brk/ld_ram* u_brk/ld_rom* u_brk/use_lm_r* u_brk/rom_r* u_brk/pl_r_* u_brk/pl_w_* u_brk/pl_side* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/pl_fresh* u_brk/ea_r* lm_raddr_q*}]
set_multicycle_path 2 -hold  -end -from [get_regs {u_brk/u_replica/*}] -to [get_regs {u_brk/ld_phys* u_brk/ld_ram* u_brk/ld_rom* u_brk/use_lm_r* u_brk/rom_r* u_brk/pl_r_* u_brk/pl_w_* u_brk/pl_side* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/pl_fresh* u_brk/ea_r* lm_raddr_q*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/u_replica/*}] -to [get_regs {u_brk/aq_*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/u_replica/*}] -to [get_regs {u_brk/aq_*}]

// ---- the probe's stand-ins for the control plane (ESP32 in the real build): the
// configuration register, quasi-static and changed with the core held in reset,
// and the ROM-image loader port, used at bring-up only
set_false_path -from [get_regs {cfg_*}]
set_false_path -from [get_regs {ld_a_* ld_d_* ld_we_*}]
