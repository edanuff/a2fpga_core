// S7 accelerator timing probe (accel_probe_top, ACCEL_PROBE_NEAR): the accelerator
// domain at the 100 MHz pin-sequencer clock, the core stepping every two clks
// (50 MHz) from the near memory.  GENERATED by gen_sdc.py - edit that.
// The exceptions are the timing contract gs_accel_broker (NEAR) documents and
// tb_gs_broker.sv asserts in clks; everything not listed is an ordinary one-clk
// path - in particular the cheap view of a step and the tag compare (the step's
// first clk) and the clock enable made from them (its second).
// See boards/a2mega/docs/gs_socket_s7_fast_core_exploration.md.
create_clock -name clk100 -period 10.000 -waveform {0 5.000} [get_ports {clk50_in}]
set_clock_uncertainty 0.5 -setup -from [get_clocks {clk100}]

// gs_ph2 and the sequencer clock are asynchronous (hdl/twgs/gs_socket.sdc).  The
// socket data byte (u_brk/d_f, PHI2-fall flops) is registered in the clk domain
// (alt_q) a clk and more after the fall, and steady there when the core takes it.
create_clock -name gs_ph2 -period 349.0 -waveform {209.4 349.0} [get_ports {gs_ph2}]
set_clock_groups -asynchronous -group [get_clocks {gs_ph2}] -group [get_clocks {clk100}]

// ---- step paths (two clks): launched when the core steps, captured when it steps
// again.  Startpoints: the core's registers, the near memory's read port, the
// core's data select and its other data source (steady for two clks before a step
// that uses it).  Endpoints: the core's registers, the near memory's read address,
// and what the broker loads from the core when it steps (the step's address and
// status, the index of the launch).
set_multicycle_path 2 -setup -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_pins {*nmem_*_s/ADB*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_pins {*nmem_*_s/ADB*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {u_brk/ea_r* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/nl_idx* u_brk/nl_ok*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {u_brk/ea_r* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/nl_idx* u_brk/nl_ok*}]
set_multicycle_path 2 -setup -end -from [get_pins {*nmem_*_s/CLKB}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 1 -hold  -end -from [get_pins {*nmem_*_s/CLKB}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 2 -setup -end -from [get_pins {*nmem_*_s/CLKB}] -to [get_pins {*nmem_*_s/ADB*}]
set_multicycle_path 1 -hold  -end -from [get_pins {*nmem_*_s/CLKB}] -to [get_pins {*nmem_*_s/ADB*}]
set_multicycle_path 2 -setup -end -from [get_pins {*nmem_*_s/CLKB}] -to [get_regs {u_brk/ea_r* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/nl_idx* u_brk/nl_ok*}]
set_multicycle_path 1 -hold  -end -from [get_pins {*nmem_*_s/CLKB}] -to [get_regs {u_brk/ea_r* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/nl_idx* u_brk/nl_ok*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/near_r*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/near_r*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/near_r*}] -to [get_pins {*nmem_*_s/ADB*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/near_r*}] -to [get_pins {*nmem_*_s/ADB*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/near_r*}] -to [get_regs {u_brk/ea_r* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/nl_idx* u_brk/nl_ok*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/near_r*}] -to [get_regs {u_brk/ea_r* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/nl_idx* u_brk/nl_ok*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/alt_q*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/alt_q*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/alt_q*}] -to [get_pins {*nmem_*_s/ADB*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/alt_q*}] -to [get_pins {*nmem_*_s/ADB*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/alt_q*}] -to [get_regs {u_brk/ea_r* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/nl_idx* u_brk/nl_ok*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/alt_q*}] -to [get_regs {u_brk/ea_r* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/nl_idx* u_brk/nl_ok*}]

// ---- the mode changes only when the core steps; it selects the interrupt lines the
// core sees, which reach its registers and (through its next status) the step registers
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/mode_native* u_brk/mode_bypass*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/mode_native* u_brk/mode_bypass*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/mode_native* u_brk/mode_bypass*}] -to [get_regs {u_brk/ea_r* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/nl_idx* u_brk/nl_ok*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/mode_native* u_brk/mode_bypass*}] -to [get_regs {u_brk/ea_r* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/nl_idx* u_brk/nl_ok*}]

// ---- the interrupt lines the core sees: in fast mode held from one core step to
// the next; in native mode the pads of the PHI2 fall, in a register from the
// second clk edge after it, two clks before the step
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/irq_h* u_brk/nmi_h* u_brk/abort_h* u_brk/irq_e* u_brk/nmi_e* u_brk/abort_e*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/irq_h* u_brk/nmi_h* u_brk/abort_h* u_brk/irq_e* u_brk/nmi_e* u_brk/abort_e*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/irq_h* u_brk/nmi_h* u_brk/abort_h* u_brk/irq_e* u_brk/nmi_e* u_brk/abort_e*}] -to [get_regs {u_brk/ea_r* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/nl_idx* u_brk/nl_ok*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/irq_h* u_brk/nmi_h* u_brk/abort_h* u_brk/irq_e* u_brk/nmi_e* u_brk/abort_e*}] -to [get_regs {u_brk/ea_r* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int* u_brk/nl_idx* u_brk/nl_ok*}]

// ---- (stated, not relaxed) the core's clock enable is one gate behind registers,
// and reaches the core in one clk
set_max_delay 10.000 -from [get_regs {u_brk/ce_c* u_brk/ce_r* u_brk/fa_c* u_brk/fb_c* u_brk/fh_c*}] -to [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}]

// ---- the full decode of a step: from the step registers (and the memory-map
// switches, which change three clks and more before it is used) to its registered
// copy and the tag compare made from it, used from the step's third clk
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/ea_r* u_brk/ea_k* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int*}] -to [get_regs {u_brk/aq_* u_brk/nh_dq*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/ea_r* u_brk/ea_k* u_brk/pl_int* u_brk/pl_we* u_brk/pl_vp_n* u_brk/pl_io_int*}] -to [get_regs {u_brk/aq_* u_brk/nh_dq*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/u_replica/*}] -to [get_regs {u_brk/aq_* u_brk/nh_dq*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/u_replica/*}] -to [get_regs {u_brk/aq_* u_brk/nh_dq*}]

// ---- the core's outputs reach the broker's other registers no sooner than the
// step's second clk: write data (registered with the write, with a socket request,
// with a posted write) and the PHY's request (the idle address during reset)
set_multicycle_path 2 -setup -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {u_brk/wd_r* u_brk/sreq_data* u_brk/pw_data* u_phy/*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_cpu/* u_cpu/MCode/* u_cpu/AddrGen/*}] -to [get_regs {u_brk/wd_r* u_brk/sreq_data* u_brk/pw_data* u_phy/*}]

// ---- a far read: its registered address is presented to the memories for two
// clks and launched in the second
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/ml_sel_r* u_brk/ml_phys* u_brk/ml_rom*}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/ml_sel_r* u_brk/ml_phys* u_brk/ml_rom*}] -to [get_pins {*mram_*_s/ADB* *mrom_*_s/ADB*}]
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/ml_sel_r* u_brk/ml_phys* u_brk/ml_rom*}] -to [get_regs {*ram_sel_* *rom_sel_*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/ml_sel_r* u_brk/ml_phys* u_brk/ml_rom*}] -to [get_regs {*ram_sel_* *rom_sel_*}]

// ---- the broker's view of the core's reset changes at a PHI2-fall event; the PHY
// takes a cycle at its issue point, never sooner than two clks after one
set_multicycle_path 2 -setup -end -from [get_regs {u_brk/run_c*}] -to [get_regs {u_phy/*}]
set_multicycle_path 1 -hold  -end -from [get_regs {u_brk/run_c*}] -to [get_regs {u_phy/*}]

// ---- the probe's stand-ins for the control plane (ESP32 in the real build): the
// configuration register, quasi-static and changed with the core held in reset,
// and the ROM-image loader port, used at bring-up only
set_false_path -from [get_regs {cfg_*}]
set_false_path -from [get_regs {ld_a_* ld_d_* ld_we_*}]

// ---- the probe's power-up reset (a counter in the top level, one net to every
// register's clear): released once, long before the socket is armed
set_false_path -from [get_regs {rst_cnt_*}]

// ---- (report only) one path per endpoint, for a wider view of the step paths
// than the default table
report_timing -setup -max_paths 400 -max_common_paths 1
