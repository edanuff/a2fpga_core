-	detectChain(32);
+	/* a2fpga patch: on esp_usb_jtag (and possibly other bridges) the first
+	 * chain scan intermittently reads all-ones when the FPGA sits in an
+	 * autoboot-failed state, while a later in-process scan succeeds (visible
+	 * in --detect output: "empty" followed by a found idcode). Retry a few
+	 * times before accepting an empty chain — prevents downstream flows from
+	 * fake-succeeding against no device. */
+	for (int _attempt = 0; _attempt < 5; ++_attempt) {
+		detectChain(32);
