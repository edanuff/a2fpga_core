openFPGALoader a2mega3 patch — supersedes openfpgaloader-a2mega2.patch.
Base: openFPGALoader v1.1.1 (85be4fa). Contains everything in a2mega2
(freq-honored flash phase, honest empty-chain errors, DPD/QPI flash revival
preamble, settle/preload knobs) PLUS the 2026-08-31 first-attempt-failure fix:
when the GW5A is already configured (Done Final + Wakeup Done — it auto-booted
the previous image), keep it configured and go straight to SPI passthrough
instead of reset+eraseSRAM, which re-arms the auto-boot scanner against the
still-valid flash image and makes the scanner's reload retries collide with
erase/write/verify (the deterministic attempt-1 failure). Opt out with
OFL_GW5A_NO_CFG_KEEP=1. See boards/a2mega/docs/jtag_flash_reliability.md
(2026-08-31 section). Build: git checkout v1.1.1 && git apply this-patch &&
cmake -B build -DCMAKE_BUILD_TYPE=Release && make -C build.
Binary: tools/bin/openFPGALoader-a2mega3, sha256
088eb4e3d402de2a20310c9256bc69d06b503883133d5e3d6a9644ef239884ef

diff --git a/src/gowin.cpp b/src/gowin.cpp
index 1383494..7be1a96 100644
--- a/src/gowin.cpp
+++ b/src/gowin.cpp
@@ -340,8 +340,64 @@ void Gowin::programFlash()
 		displayReadReg("after program flash", readStatusReg());
 }
 
+/* GW5A external-flash boot-race mitigation (a2mega forensics 2026-08):
+ * after eraseSRAM the boot controller periodically re-scans MSPI for a
+ * bootable image; with content present it can reload the FPGA MID-SESSION,
+ * corrupting the JTAG-SPI passthrough (timeouts, dropped writes, wedged
+ * TAP). Blank flash = scanner gives up = deterministic writes.
+ * Primary fix: JTAG-configure the device FIRST (preload the very image
+ * being flashed into SRAM) -> DONE held -> scanner quiesced for the whole
+ * session. Opt out with OFL_GW5A_NO_SRAM_FIRST=1 (required for designs
+ * that use MSPI pins as user I/O). Fallback knob: OFL_GW5A_SETTLE_MS
+ * (default 500) replaces the fixed 100 ms post-erase settle. */
+static bool gw5a_sram_first_enabled()
+{
+	const char *e = getenv("OFL_GW5A_NO_SRAM_FIRST");
+	return !(e && e[0] == '1');
+}
+
+static unsigned gw5a_settle_us()
+{
+	const char *e = getenv("OFL_GW5A_SETTLE_MS");
+	return (e ? (unsigned)atoi(e) : 500) * 1000;
+}
+
 void Gowin::programExtFlash(unsigned int offset, bool unprotect_flash)
 {
+	/* a2mega3 fix (first-attempt flash failures, 2026-08-31 forensics):
+	 * if the device is ALREADY configured (Done Final + Wakeup Done — it
+	 * auto-booted the previous flash image), the boot scanner is finished
+	 * and quiescent. The stock reset+eraseSRAM below would RE-ARM it; the
+	 * re-armed scanner then reloads the (still valid, multi-second) image
+	 * and its retries collide with erase/write/verify — the deterministic
+	 * attempt-1 failure. Instead treat this state exactly like a completed
+	 * SRAM preload: skip reset/eraseSRAM and go straight to SPI. Opt out
+	 * with OFL_GW5A_NO_CFG_KEEP=1. */
+	if (is_gw5a) {
+		const char *e = getenv("OFL_GW5A_NO_CFG_KEEP");
+		if (!(e && e[0] == '1')) {
+			uint32_t st = readStatusReg();
+			if ((st & (1u << 13)) && (st & (1u << 30))) {
+				printInfo("GW5A: device configured (DONE held) - "
+					"keeping it; auto-boot scanner stays quiescent");
+				_gw5a_cfg_loaded = true;
+			}
+		}
+	}
+
+	if (is_gw5a && _fs && !_gw5a_cfg_loaded && gw5a_sram_first_enabled()) {
+		printInfo("GW5A: preloading image to SRAM (quiesce auto-boot scanner)");
+		/* Work around FPGA stuck in Bad Command status */
+		reset();
+		_jtag->set_state(Jtag::RUN_TEST_IDLE);
+		_jtag->toggleClk(1000000);
+		if (eraseSRAM() && writeSRAM(_fs->getData(), _fs->getLength())) {
+			_gw5a_cfg_loaded = true;
+		} else {
+			printWarn("GW5A: SRAM preload failed; falling back to settle-delay path");
+		}
+	}
+
 	displayReadReg("after program flash", readStatusReg());
 
 	if (!prepare_flash_access()) {
@@ -1220,6 +1276,18 @@ void Gowin::gw2a_force_state()
 
 bool Gowin::prepare_flash_access()
 {
+	if (is_gw5a && _gw5a_cfg_loaded) {
+		/* device is configured (SRAM preload): DO NOT reset or erase SRAM
+		 * - that would re-arm the auto-boot scanner. Straight to SPI. */
+		usleep(gw5a_settle_us());
+		if (!gw5a_enable_spi()) {
+			printError("Error: fail to switch GW5A to SPI mode");
+			return false;
+		}
+		usleep(100000);
+		return true;
+	}
+
 	/* Work around FPGA stuck in Bad Command status */
 	if (is_gw5a) {
 		reset();
@@ -1233,12 +1301,23 @@ bool Gowin::prepare_flash_access()
 	}
 
 	if (is_gw5a) {
-		usleep(100000);
+		usleep(gw5a_settle_us());
 		if (!gw5a_enable_spi()) {
 			printError("Error: fail to switch GW5A to SPI mode");
 			return false;
 		}
 		usleep(100000);
+		/* a2fpga patch: revive a flash stuck in deep-power-down /
+		 * continuous-read / QPI mode — states in which single-SPI
+		 * commands (incl. JEDEC 0x9F) are ignored and reads return
+		 * zeros. Sequence: Release-from-DPD (0xAB), then software
+		 * reset enable+reset (0x66/0x99), then settle. Harmless on a
+		 * healthy chip. */
+		spi_put_gw5a(0xAB, NULL, NULL, 0);
+		usleep(1000);
+		spi_put_gw5a(0x66, NULL, NULL, 0);
+		spi_put_gw5a(0x99, NULL, NULL, 0);
+		usleep(1000);
 	} else if (!is_gw2a) {
 		if (!enableCfg()) {
 			return false;
@@ -1246,7 +1325,10 @@ bool Gowin::prepare_flash_access()
 		send_command(0x3D);
 	}
 
-	_jtag->setClkFreq(10000000);
+	/* a2fpga patch: 10 MHz hardcode ignored the user's --freq and is
+	 * marginal through the esp_usb_jtag bridge (flash ID reads return
+	 * garbage: "Read ID failed" / "flash chip unknown" / phantom BP bits).
+	 * Keep the user's JTAG frequency for SPI-over-JTAG flash access. */
 
 	return true;
 }
